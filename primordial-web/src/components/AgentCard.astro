---
import type { CatalogAgent } from '../lib/types';
import { displayName, fmtCount, fmtRating } from '../lib/format';
import TrustBadge from './TrustBadge.astro';

interface Props { agent: CatalogAgent; }
const { agent } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const s = agent.signals ?? {};
const tags = (agent.tags ?? []).slice(0, 4);
const name = displayName(agent);

// Data attributes power client-side search/filter/sort without any framework.
const haystack = [
  name, agent.id, agent.description, agent.category,
  (agent.tags ?? []).join(' '), agent.language, (agent.providers ?? []).join(' '),
].filter(Boolean).join(' ').toLowerCase();
---
<a
  class="card"
  href={`${base}/agents/${agent.id}`}
  data-card
  data-search={haystack}
  data-category={agent.category ?? ''}
  data-language={agent.language ?? ''}
  data-trust={agent.trust ?? ''}
  data-tags={(agent.tags ?? []).join('|')}
  data-stars={s.stars ?? 0}
  data-runs={s.runs_30d ?? 0}
  data-rating={s.rating_avg ?? 0}
>
  <div class="card-head">
    <div>
      <h3 class="card-title">{name}</h3>
      <div class="card-id">{agent.id}</div>
    </div>
    <TrustBadge trust={agent.trust} />
  </div>

  <p class="card-desc">{agent.description ?? agent.readme_excerpt ?? 'No description provided.'}</p>

  {tags.length > 0 && (
    <div class="card-tags">
      {agent.category && <span class="tag">{agent.category}</span>}
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  )}

  <div class="card-meta">
    <span class="stat" title="GitHub stars">★ {fmtCount(s.stars)}</span>
    <span class="stat" title="Runs in last 30 days">▶ {fmtCount(s.runs_30d)}</span>
    <span class="stat" title="Average rating">☆ {fmtRating(s.rating_avg, s.rating_count)}</span>
    {agent.language && <span class="stat faint">{agent.language}</span>}
  </div>
</a>
