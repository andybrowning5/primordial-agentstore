---
import '../styles/global.css';
import HelixAnimation from '../components/HelixAnimation.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Primordial AgentStore', description = 'An open-source marketplace for sandboxed AI agents.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Decide BEFORE first paint whether to play the intro (homepage, first
      // visit this session, motion allowed). Setting the class on <html> early
      // avoids a flash of the page before the overlay covers it.
      (function () {
        try {
          var p = location.pathname;
          var isHome = p === '/' || p === '' || p.endsWith('/index.html');
          var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          var played = sessionStorage.getItem('introPlayed');
          if (isHome && !reduce && !played) {
            document.documentElement.classList.add('intro-active');
            // Safety net: if the sequencing script never runs, never leave
            // the page hidden.
            setTimeout(function () {
              var r = document.documentElement;
              if (r.classList.contains('intro-active')) {
                r.classList.remove('intro-active', 'intro-lock');
                var i = document.getElementById('intro');
                if (i) i.style.display = 'none';
              }
            }, 6000);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={`${base}/`} aria-label="Primordial AgentStore — home">
          <HelixAnimation />
          <span class="wordmark"><span class="wm-1">Primordial</span> <span class="wm-2">AgentStore</span></span>
        </a>
        <nav class="nav-links">
          <a href={`${base}/#get-started`}>Get started</a>
          <a href={`${base}/#browse`}>Browse</a>
          <a href={`${base}/gallery`}>Living Systems</a>
          <a href="https://github.com/andybrowning5/primordial-agentstore" target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>Primordial AgentStore — run untrusted agents safely, in the cloud.</span>
        <span class="faint">Beta. Review agent permissions before approving. Use at your own risk.</span>
      </div>
    </footer>
  </body>
</html>
