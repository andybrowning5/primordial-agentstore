---
import Base from '../../../layouts/Base.astro';
import TrustBadge from '../../../components/TrustBadge.astro';
import PermissionsPanel from '../../../components/PermissionsPanel.astro';
import CopyCommand from '../../../components/CopyCommand.astro';
import { getAgents, getAgentDetail, getAgentStats } from '../../../lib/data';
import {
  displayName, fmtCount, fmtRating, fmtPercent, fmtDate, runCommands, splitId, renderReadme,
} from '../../../lib/format';
import type { AgentDetail } from '../../../lib/types';

export async function getStaticPaths() {
  const agents = await getAgents();
  const out = [];
  for (const a of agents) {
    const { owner, repo } = splitId(a.id);
    if (!owner || !repo) continue;
    const detail = await getAgentDetail(a.id);
    out.push({ params: { owner, repo }, props: { detail } });
  }
  return out;
}

interface Props { detail: AgentDetail | null; }
const { detail } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Should not happen given getStaticPaths, but tolerate gracefully.
if (!detail) {
  return Astro.redirect(`${base}/`);
}

// Live stats refresh (no-op against fixtures); merge over baked signals.
const live = await getAgentStats(detail.id);
const s = { ...(detail.signals ?? {}), ...(live ?? {}) };

const name = displayName(detail);
const cmds = runCommands(detail.id);
const author = detail.author ?? {};

const readmeHtml = renderReadme(detail);
const providers = detail.providers ?? [];
---
<Base title={`${name} — Primordial AgentStore`} description={detail.description ?? undefined}>
  <header class="detail-header">
    <div class="detail-sub">
      <span class="card-id">{detail.id}</span>
      <TrustBadge trust={detail.trust} />
      {detail.language && <span class="badge badge-lang">{detail.language}</span>}
      {detail.version && <span class="faint">v{detail.version}</span>}
    </div>
    <h1>{name}</h1>
    <p class="muted" style="max-width:680px">{detail.description}</p>
  </header>

  <div class="detail-grid">
    <div>
      <PermissionsPanel permissions={detail.permissions} />

      {readmeHtml && (
        <div class="panel">
          <h3>Readme</h3>
          <div class="readme" set:html={readmeHtml} />
        </div>
      )}

      {!readmeHtml && (
        <div class="panel">
          <h3>Readme</h3>
          <p class="muted">No README available for this agent.</p>
        </div>
      )}

      <a class="back-link" href={`${base}/#browse`}>← Back to all agents</a>
    </div>

    <aside>
      <div class="panel">
        <h3>Run this agent</h3>
        <CopyCommand label="Primordial CLI" command={cmds.cli} />
        <CopyCommand label="MCP (Claude Code / hosts)" command={cmds.mcp} />
        <p class="data-source-note">You'll review and approve these permissions before it runs.</p>
      </div>

      <div class="panel">
        <h3>Signals</h3>
        <div class="kv"><span class="k">Stars</span><span class="v">★ {fmtCount(s.stars)}</span></div>
        <div class="kv"><span class="k">Runs (30d)</span><span class="v">{fmtCount(s.runs_30d)}</span></div>
        <div class="kv"><span class="k">Rating</span><span class="v">{fmtRating(s.rating_avg, s.rating_count)}</span></div>
        <div class="kv"><span class="k">Success rate</span><span class="v">{fmtPercent(s.success_rate)}</span></div>
      </div>

      <div class="panel">
        <h3>Details</h3>
        {detail.category && <div class="kv"><span class="k">Category</span><span class="v">{detail.category}</span></div>}
        <div class="kv"><span class="k">Version</span><span class="v">{detail.version ?? '—'}</span></div>
        <div class="kv"><span class="k">Ref</span><span class="v">{detail.ref ?? '—'}</span></div>
        {detail.commit && <div class="kv"><span class="k">Commit</span><span class="v">{detail.commit.slice(0, 10)}</span></div>}
        <div class="kv"><span class="k">Updated</span><span class="v">{fmtDate(detail.updated_at)}</span></div>
        <div class="kv">
          <span class="k">Source</span>
          <span class="v"><a href={detail.url} target="_blank" rel="noopener">GitHub ↗</a></span>
        </div>
      </div>

      {providers.length > 0 && (
        <div class="panel">
          <h3>Providers</h3>
          <div class="provider-chips">
            {providers.map((p) => <span class="tag">{p}</span>)}
          </div>
        </div>
      )}

      {(detail.tags ?? []).length > 0 && (
        <div class="panel">
          <h3>Tags</h3>
          <div class="card-tags" style="margin:0">
            {(detail.tags ?? []).map((t) => <span class="tag">{t}</span>)}
          </div>
        </div>
      )}

      {(author.name || author.github) && (
        <div class="panel">
          <h3>Author</h3>
          <div class="kv"><span class="k">Name</span><span class="v">{author.name ?? '—'}</span></div>
          {author.github && (
            <div class="kv"><span class="k">GitHub</span><span class="v"><a href={`https://github.com/${author.github}`} target="_blank" rel="noopener">@{author.github}</a></span></div>
          )}
          {author.website && (
            <div class="kv"><span class="k">Website</span><span class="v"><a href={author.website} target="_blank" rel="noopener">Link ↗</a></span></div>
          )}
        </div>
      )}
    </aside>
  </div>
</Base>
