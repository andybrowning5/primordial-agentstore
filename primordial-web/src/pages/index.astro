---
import Base from '../layouts/Base.astro';
import AgentCard from '../components/AgentCard.astro';
import CopyCommand from '../components/CopyCommand.astro';
import { getAgents, usingLiveIndex } from '../lib/data';
import { distinct } from '../lib/format';

const agents = await getAgents();

const categories = distinct(agents.map((a) => a.category));
const languages = distinct(agents.map((a) => a.language));
const tags = distinct(agents.flatMap((a) => a.tags ?? []));
const trustTiers = distinct(agents.map((a) => a.trust));
---
<Base>
  <div id="intro" aria-hidden="true">
    <div class="intro-stage">
      <pre class="helix intro-helix" id="intro-helix"></pre>
      <div class="intro-title"><span class="wm-1">Primordial</span> <span class="wm-2">AgentStore</span></div>
    </div>
  </div>

  <section class="hero">
    <h1 class="reveal-item" style="--i:0">Run any AI agent safely, in seconds.</h1>
    <p class="tagline reveal-item" style="--i:1">
      Primordial is an open-source marketplace for sandboxed AI agents. Pick an agent,
      review its permissions, and it runs in a cloud sandbox — never on your machine, never
      touching your API keys. Claude Code can discover and call any agent in the ecosystem
      mid-task.
    </p>
    <div class="hero-actions reveal-item" style="--i:2">
      <a class="btn" href="#get-started">Get started</a>
      <a class="btn btn-ghost" href="#browse">Browse agents</a>
      <a class="btn btn-ghost" href="https://github.com/andybrowning5/primordial-agentstore" target="_blank" rel="noopener">View on GitHub</a>
    </div>

    <div class="feature-grid">
      <div class="feature reveal-item" style="--i:3">
        <h3>Sandboxed by default</h3>
        <p>Every agent runs in an isolated cloud microVM. Your keys are injected by a proxy — the agent code never sees them.</p>
      </div>
      <div class="feature reveal-item" style="--i:4">
        <h3>Any language, zero SDK</h3>
        <p>NDJSON over stdin/stdout is the whole protocol. Push to GitHub, tag it, and anyone can run it.</p>
      </div>
      <div class="feature reveal-item" style="--i:5">
        <h3>Permissions you approve</h3>
        <p>Network domains, filesystem access, and delegation are declared up front. You see exactly what an agent can do.</p>
      </div>
    </div>
  </section>

  <section id="get-started" class="reveal-item" style="--i:6">
    <div class="section-head">
      <h2>Get started</h2>
      <span class="muted">~2 minutes</span>
    </div>
    <p class="muted getstarted-intro">
      Primordial is a CLI plus a built-in MCP server. Install it, add your keys, then connect
      it to Claude Code or Codex so they can discover and run agents mid-task — sandboxed in
      the cloud, never touching your API keys.
    </p>

    <div class="steps">
      <div class="step">
        <div class="step-num">1</div>
        <div class="step-body">
          <h3>Install the CLI</h3>
          <p class="muted">
            Requires Python 3.11+ and a free
            <a href="https://e2b.dev/dashboard" target="_blank" rel="noopener">E2B API key</a>
            (agents run in E2B cloud sandboxes).
          </p>
          <CopyCommand label="Install" command="pip install primordial-agentstore" />
          <CopyCommand label="Add your API keys (E2B, Anthropic, …) to the encrypted local vault" command="primordial setup" />
        </div>
      </div>

      <div class="step">
        <div class="step-num">2</div>
        <div class="step-body">
          <h3>Connect it to Claude Code or Codex</h3>
          <p class="muted">One command registers Primordial's MCP server with every host it detects:</p>
          <CopyCommand label="Auto-detect installed hosts" command="primordial mcp install" />
          <p class="muted step-or">…or target a specific host:</p>
          <CopyCommand label="Claude Code" command="primordial mcp install --host claude" />
          <CopyCommand label="Codex CLI / Desktop" command="primordial mcp install --host codex" />
          <p class="faint step-note">
            Then restart your host. Primordial appears as an MCP server with tools to search
            and run agents. Cursor, Windsurf, Claude Desktop and OpenClaw are supported too
            (<code>--host cursor</code>, <code>windsurf</code>, <code>claude-desktop</code>, <code>openclaw</code>).
          </p>
        </div>
      </div>

      <div class="step">
        <div class="step-num">3</div>
        <div class="step-body">
          <h3>Use it</h3>
          <p class="muted">
            Just ask naturally — your host searches the marketplace, picks an agent, runs it
            sandboxed in the cloud, and relays the result:
          </p>
          <div class="prompt-eg">“use primordial to research the latest on &lt;topic&gt;”</div>
          <div class="prompt-eg">“find a primordial agent that checks my repo's docs for drift”</div>
          <p class="faint step-note">
            If an agent needs a key you haven't added, you'll be told exactly what to run
            (e.g. <code>primordial keys add anthropic</code>). When an agent edits files, review
            and apply the changes with <code>primordial apply --last</code>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="browse" class="reveal-item" style="--i:7">
    <div class="section-head">
      <h2>Browse agents</h2>
      <span class="muted" id="result-count">{agents.length} agents</span>
    </div>

    <div class="controls">
      <div class="search-row">
        <input
          id="search"
          class="search-input"
          type="search"
          placeholder="Search by name, description, tag, provider…"
          autocomplete="off"
          aria-label="Search agents"
        />
        <label class="faint" for="sort" style="font-size:0.85rem">Sort</label>
        <select id="sort" aria-label="Sort agents">
          <option value="stars">Most starred</option>
          <option value="runs">Most popular (runs/30d)</option>
          <option value="rating">Highest rated</option>
          <option value="name">Name (A–Z)</option>
        </select>
      </div>

      <div class="facets">
        {categories.length > 0 && (
          <div class="facet-group">
            <span class="facet-label">Category</span>
            {categories.map((c) => (
              <button class="chip-toggle" data-facet="category" data-value={c} aria-pressed="false">{c}</button>
            ))}
          </div>
        )}
        {trustTiers.length > 0 && (
          <div class="facet-group">
            <span class="facet-label">Trust</span>
            {trustTiers.map((t) => (
              <button class="chip-toggle" data-facet="trust" data-value={t} aria-pressed="false">{t === 'requires_approval' ? 'requires approval' : t}</button>
            ))}
          </div>
        )}
        {languages.length > 0 && (
          <div class="facet-group">
            <span class="facet-label">Language</span>
            {languages.map((l) => (
              <button class="chip-toggle" data-facet="language" data-value={l} aria-pressed="false">{l}</button>
            ))}
          </div>
        )}
        {tags.length > 0 && (
          <div class="facet-group">
            <span class="facet-label">Tag</span>
            {tags.map((t) => (
              <button class="chip-toggle" data-facet="tags" data-value={t} aria-pressed="false">{t}</button>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="grid" id="grid">
      {agents.map((agent) => <AgentCard agent={agent} />)}
    </div>

    <div class="empty" id="empty" hidden>No agents match your filters.</div>

    <p class="data-source-note">
      {usingLiveIndex ? 'Data: live index service.' : 'Data: local mock fixture (index service not yet deployed).'}
    </p>
  </section>
</Base>

<script>
  // Vanilla client-side search / facet filtering / sort. No framework.
  const search = document.getElementById('search') as HTMLInputElement;
  const sortSel = document.getElementById('sort') as HTMLSelectElement;
  const grid = document.getElementById('grid') as HTMLElement;
  const empty = document.getElementById('empty') as HTMLElement;
  const countEl = document.getElementById('result-count') as HTMLElement;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  const facetBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip-toggle'));

  // active[facetName] = Set of selected values (OR within a facet, AND across facets)
  const active: Record<string, Set<string>> = { category: new Set(), trust: new Set(), language: new Set(), tags: new Set() };

  function num(el: HTMLElement, attr: string): number {
    return parseFloat(el.dataset[attr] ?? '0') || 0;
  }

  function matches(card: HTMLElement, q: string): boolean {
    if (q && !(card.dataset.search ?? '').includes(q)) return false;
    for (const [facet, values] of Object.entries(active)) {
      if (values.size === 0) continue;
      if (facet === 'tags') {
        const cardTags = (card.dataset.tags ?? '').split('|').filter(Boolean);
        if (![...values].some((v) => cardTags.includes(v))) return false;
      } else {
        const cardVal = card.dataset[facet] ?? '';
        if (!values.has(cardVal)) return false;
      }
    }
    return true;
  }

  function apply() {
    const q = search.value.trim().toLowerCase();
    const sort = sortSel.value;
    let visible = cards.filter((c) => matches(c, q));

    visible.sort((a, b) => {
      if (sort === 'name') {
        const an = a.querySelector('.card-title')?.textContent ?? '';
        const bn = b.querySelector('.card-title')?.textContent ?? '';
        return an.localeCompare(bn);
      }
      const key = sort === 'runs' ? 'runs' : sort === 'rating' ? 'rating' : 'stars';
      return num(b, key) - num(a, key);
    });

    // Hide all, then re-append visible in sorted order.
    cards.forEach((c) => { c.style.display = 'none'; });
    visible.forEach((c) => { c.style.display = ''; grid.appendChild(c); });

    empty.hidden = visible.length > 0;
    countEl.textContent = `${visible.length} agent${visible.length === 1 ? '' : 's'}`;
  }

  search.addEventListener('input', apply);
  sortSel.addEventListener('change', apply);
  facetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const facet = btn.dataset.facet!;
      const value = btn.dataset.value!;
      const set = active[facet];
      if (set.has(value)) { set.delete(value); btn.setAttribute('aria-pressed', 'false'); }
      else { set.add(value); btn.setAttribute('aria-pressed', 'true'); }
      apply();
    });
  });

  apply();
</script>

<script>
  // Intro: big centered helix glides into the header brand, then the page
  // elements cascade in. Plays once per session on the homepage; reduced-motion
  // and revisits skip it (gated in the head script in Base.astro).
  const root = document.documentElement;
  const intro = document.getElementById('intro');

  function reveal() {
    root.classList.remove('intro-active', 'intro-lock');
    root.classList.add('intro-go');
    try { sessionStorage.setItem('introPlayed', '1'); } catch (e) {}
  }
  function finishIntro() {
    if (intro && intro.parentNode) intro.remove();
    reveal();
  }

  if (root.classList.contains('intro-active') && intro) {
    root.classList.add('intro-lock');
    const big = document.getElementById('intro-helix');
    const target = document.getElementById('helix'); // the header brand helix

    const HOLD = 1150;   // beat on the centered helix
    const GLIDE = 950;   // glide-to-corner duration (matches CSS transition)

    setTimeout(() => {
      if (big && target) {
        const t = target.getBoundingClientRect();
        const b = big.getBoundingClientRect();
        if (b.width > 0 && t.width > 0) {
          const dx = (t.left + t.width / 2) - (b.left + b.width / 2);
          const dy = (t.top + t.height / 2) - (b.top + b.height / 2);
          const scale = t.width / b.width;
          big.style.transform = `translate(${dx}px, ${dy}px) scale(${scale})`;
        }
      }
      intro.classList.add('intro-fade'); // fade the black backdrop away
      setTimeout(finishIntro, GLIDE);
    }, HOLD);

    // Safety: never leave content hidden if something stalls.
    setTimeout(() => { if (root.classList.contains('intro-active')) finishIntro(); }, 4500);
  }
</script>
