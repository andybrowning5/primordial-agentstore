graph LR
    subgraph local ["Local Machine"]
        repo["Your Repo\nmain branch"]
        wt["Git Worktree\nprimordial/agent--session"]
    end

    subgraph cloud ["Firecracker Sandbox"]
        snap["Workspace\nSnapshot"]
        work["Agent\nModifies Files"]
        diff["git diff\nCaptured"]
    end

    subgraph review ["Review"]
        check["git diff\nmain..branch"]
        decide{Merge?}
        merge["git merge"]
        cleanup["worktree remove"]
    end

    repo -->|"1 · snapshot"| snap
    repo -->|"1 · create worktree"| wt
    snap -->|"2 · agent runs"| work
    work -->|"3 · capture"| diff
    diff -->|"4 · apply patch"| wt
    wt -->|"5 · review"| check
    check --> decide
    decide -->|yes| merge
    decide -->|no| cleanup
    merge --> cleanup

    classDef default fill:#1e293b,stroke:#334155,color:#e2e8f0
    classDef accent fill:#1e3a5f,stroke:#3b82f6,color:#e2e8f0
    classDef decision fill:#334155,stroke:#3b82f6,color:#e2e8f0

    class snap,work,diff accent
    class decide decision
