graph TB
    subgraph users [" "]
        direction LR
        CLI["primordial CLI"]
        CC["Claude Code &middot; OpenClaw &middot; Codex"]
    end

    subgraph host ["Host"]
        direction LR
        Daemon["HTTP Daemon\nlocalhost:19400"]
        Vault["Key Vault\nAES-128"]
        Manifest["Manifest\nValidator"]
        GH["GitHub\nResolver"]
        WT["Worktree\nManager"]
    end

    subgraph sandbox ["Firecracker microVM"]
        subgraph root [" "]
            Hardening["Hardening\nsudo removed &middot; hidepid=2"]
            Proxy["API Key Proxy\nlocalhost:9001+"]
        end
        subgraph agent_ctx [" "]
            Agent["Agent Process\nstdin/stdout"]
            WS["workspace/"]
            State["data/ &middot; output/ &middot; state/"]
        end
    end

    APIs["External APIs\napi.anthropic.com &middot; etc."]

    CC -->|"HTTP"| Daemon
    CLI --> Manifest
    Daemon --> Manifest
    Daemon --> Vault
    CLI --> Vault
    Manifest --> GH
    Vault -->|"keys"| Proxy
    WT -->|"snapshot"| WS
    Agent -->|"session token"| Proxy
    Proxy -->|"real key"| APIs
    Agent --> WS
    Agent --> State
    WS -->|"diff"| WT

    classDef default fill:#1e293b,stroke:#334155,color:#e2e8f0
    classDef accent fill:#1e3a5f,stroke:#3b82f6,color:#e2e8f0
    classDef dim fill:#0f172a,stroke:#334155,color:#94a3b8

    class Agent,Proxy accent
    class APIs dim
