graph TB
    subgraph L1 ["Key Storage"]
        direction LR
        inputs["Hardware UUID\nmacOS Keychain\nOptional password"]
        encrypt["AES-128-CBC\nHMAC-SHA256"]
        vault["keys.enc"]
        inputs --> encrypt --> vault
    end

    subgraph L2 ["VM Isolation"]
        direction LR
        vm["Firecracker microVM"]
        harden["sudo/su removed\nhidepid=2\nnetwork locked"]
        vm --- harden
    end

    subgraph L3 ["API Key Proxy"]
        direction LR
        proxy["Root-owned proxy\nmode 700"]
        tokens["Session tokens\nheader filtering\nport pre-binding"]
        proxy --- tokens
    end

    subgraph L4 ["State Isolation"]
        direction LR
        persist["Persisted\nworkspace · data\noutput · state"]
        wiped["Wiped\ndotfiles · .config\n.ssh · everything else"]
        persist --- wiped
    end

    subgraph L5 ["Workspace Isolation"]
        direction LR
        worktree["Git worktree\nseparate branch"]
        review["Manual review\nbefore merge"]
        worktree --- review
    end

    L1 --> L2 --> L3 --> L4 --> L5

    classDef default fill:#1e293b,stroke:#334155,color:#e2e8f0
    classDef layer fill:#0f172a,stroke:#1e3a5f,color:#94a3b8
