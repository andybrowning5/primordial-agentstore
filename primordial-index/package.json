{
  "name": "primordial-index",
  "version": "0.1.0",
  "private": true,
  "description": "Primordial Index service — crawler + HTTP API (Cloudflare Worker + D1 + R2)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply primordial-index --local",
    "db:migrate:remote": "wrangler d1 migrations apply primordial-index --remote"
  },
  "dependencies": {
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.5.0",
    "vitest": "2.0.5",
    "wrangler": "^3.78.0"
  }
}
